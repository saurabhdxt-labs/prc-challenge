# Data NEVER enters the repo. The challenge supplies it; redistribution is not ours to do.
# One exception: the stored ADS-B stack models (fitted models, no raw data; 7.4 MB) that every final config reads and a
# clone cannot regenerate (docs/fm1/DATA_SOURCES.md). Git cannot re-include a file under an excluded directory, so the
# path is opened one level at a time.
data/*
!data/r12/
data/r12/*
!data/r12/r13_stack_full/
data/r12/r13_stack_full/*
!data/r12/r13_stack_full/models_lgbcat/
*.parquet
*.csv
*.zip

# Outputs. `reports/` is deliberately NOT ignored: prize eligibility requires
# "sufficient documentation to understand and reproduce the results", and a repo
# whose every result artifact is ignored has nothing to reproduce against.
# Large or regenerable artifacts are excluded individually instead.
submissions/
reports/**/*.parquet
*.joblib
*.pkl

# Run logs and fitted model artefacts: regenerable (docs/fm1/REPRODUCE.md), never part of the record.
logs/
artifacts/

# Handoffs are working files for the next session, never part of the record.
_HANDOFF_*.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Credentials — nothing with a secret ever gets tracked
.env
*.pem
credentials*
*_secret*
